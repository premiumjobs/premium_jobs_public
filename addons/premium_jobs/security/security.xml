<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Premium Jobs Categories -->
        <record id="module_category_premium_jobs" model="ir.module.category">
            <field name="name">Premium Jobs</field>
            <field name="description">Manage access for Premium Jobs platform</field>
            <field name="sequence">10</field>
        </record>
        
        <!-- Group: Super Administrator -->
        <record id="group_premium_super_admin" model="res.groups">
            <field name="name">Super Administrator</field>
            <field name="category_id" ref="module_category_premium_jobs"/>
            <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <!-- Group: Coordinator -->
        <record id="group_premium_coordinator" model="res.groups">
            <field name="name">Hiring Coordinator</field>
            <field name="category_id" ref="module_category_premium_jobs"/>
            <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
        </record>
        
        <!-- Group: Client -->
        <record id="group_premium_client" model="res.groups">
            <field name="name">Client</field>
            <field name="category_id" ref="module_category_premium_jobs"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- Group: Freelancer -->
        <record id="group_premium_freelancer" model="res.groups">
            <field name="name">Freelancer</field>
            <field name="category_id" ref="module_category_premium_jobs"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        
        <!-- Group: Finance Manager -->
        <record id="group_premium_finance_manager" model="res.groups">
            <field name="name">מנהל כספים</field>
            <field name="category_id" ref="module_category_premium_jobs"/>
            <field name="comment">גישה לצפייה וניהול תשלומים לפרילנסרים</field>
        </record>
        
    </data>
    
    <!-- Global Rules (applied to all users) -->
    <data noupdate="1">
        <!-- Allow public/portal users to read company partners (tenants) for job viewing -->
        <record id="res_partner_public_read_rule" model="ir.rule">
            <field name="name">Public: Read Company Partners</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('is_company', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>

