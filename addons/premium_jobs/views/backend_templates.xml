<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Add Assistant font to backend/CRM -->
<template id="assistant_font_backend" inherit_id="web.layout" name="Assistant Font - Backend">
    <xpath expr="//head" position="inside">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
        <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@200..800&amp;display=swap" rel="stylesheet"/>
        <style>
            body {
                font-family: 'Assistant', sans-serif;
            }
        </style>
    </xpath>
</template>

</odoo>

