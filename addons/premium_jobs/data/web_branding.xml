<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override web.layout to change backend title and favicon -->
    <template id="web_layout_branding" inherit_id="web.layout" priority="99">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'Premium Jobs'"/>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/png" rel="shortcut icon" t-att-href="x_icon or '/premium_jobs/static/img/favicon.png'"/>
        </xpath>
    </template>
</odoo>

