<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Override OdooBot name to PJBot -->
        <record id="base.partner_root" model="res.partner">
            <field name="name">PJBot</field>
        </record>
        
        <!-- Override OdooBot user -->
        <function model="res.users" name="write">
            <value eval="[ref('base.user_root')]"/>
            <value eval="{'name': 'PJBot'}"/>
        </function>
        
    </data>
</odoo>
